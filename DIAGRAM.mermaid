flowchart TD

subgraph group_browser["Browser control"]
  node_ui["Browser UI<br/>[ui.js]"]
  node_app["App facade<br/>[a8e.js]"]
  node_automation["Automation API<br/>[automation_api.js]"]
  node_worker["Emulator worker<br/>[emulator_worker.js]"]
end

subgraph group_machine["Emulation core"]
  node_machine_js["Atari machine<br/>[atari.js]"]
  node_cpu["6502 CPU<br/>[cpu.js]"]
  node_memory[("Memory maps<br/>[memory.js]")]
  node_io["Hardware I/O<br/>[io.js]"]
  node_antic["ANTIC video<br/>[antic.js]"]
  node_gtia["GTIA graphics<br/>[gtia.js]"]
  node_pokey["POKEY sound I/O<br/>[pokey.js]"]
  node_playfield["Playfield renderer<br/>[renderer_base.js]"]
end

subgraph group_media_dev["Media and tools"]
  node_disk[("Disk library<br/>[disk_library.js]")]
  node_hostfs["Host filesystem<br/>[hostfs.js]"]
  node_snapshot["Machine snapshots<br/>[atari_snapshot.js]"]
  node_debugger["Debugger<br/>[debugger.js]"]
  node_assembler["Assembler<br/>[assembler_core.js]"]
  node_artifacts["Failure artifacts<br/>[artifacts.js]"]
end

subgraph group_output["Audio and display"]
  node_gl["WebGL renderer<br/>[gl.js]"]
  node_software["Canvas renderer<br/>[software.js]"]
  node_audio["Audio runtime<br/>[runtime.js]"]
  node_worklet["Audio worklet<br/>[worklet.js]"]
end

subgraph group_native["Native emulator"]
  node_native_app["Native application<br/>[A8E.c]"]
  node_native_cpu["Native 6502<br/>[6502.c]"]
  node_native_io["Native Atari I/O<br/>[AtariIo.c]"]
  node_native_antic["Native ANTIC<br/>[Antic.c]"]
  node_native_gtia["Native GTIA<br/>[Gtia.c]"]
  node_native_pokey["Native POKEY<br/>[Pokey.c]"]
end

node_user(("User or agent"))

node_user -->|"controls"| node_ui
node_ui -->|"starts and configures"| node_app
node_user -.->|"scripts"| node_automation
node_automation -->|"controls and queries"| node_app
node_app -.->|"dispatches commands"| node_worker
node_worker -.->|"creates and controls"| node_machine_js
node_machine_js -->|"executes"| node_cpu
node_machine_js -->|"configures maps"| node_memory
node_machine_js -->|"coordinates devices"| node_io
node_io -->|"dispatches video"| node_antic
node_io -->|"dispatches graphics I/O"| node_gtia
node_io -->|"dispatches sound I/O"| node_pokey
node_antic -->|"renders scanlines"| node_playfield
node_playfield -->|"supplies pixels"| node_gl
node_playfield -->|"supplies pixels"| node_software
node_pokey -->|"feeds audio"| node_audio
node_audio -.->|"queues samples"| node_worklet
node_app -->|"loads and mounts disks"| node_disk
node_app -->|"accesses files"| node_hostfs
node_app -->|"saves and loads state"| node_snapshot
node_app -->|"queries and controls"| node_debugger
node_app -->|"assembles source"| node_assembler
node_automation -->|"captures failures"| node_artifacts
node_user -->|"runs emulator"| node_native_app
node_native_app -->|"executes machine code"| node_native_cpu
node_native_app -->|"coordinates hardware I/O"| node_native_io
node_native_io -->|"uses video hardware"| node_native_antic
node_native_io -->|"uses graphics hardware"| node_native_gtia
node_native_io -->|"uses sound hardware"| node_native_pokey

